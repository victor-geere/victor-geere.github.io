/-- **The density enclosure at `c = 1/5`.** -/
theorem density_mem_c1 : IntersectionForm.density (1/20) ((1)/(5) : ℝ) ∈ Set.Icc ((-2549554498814054566553338577426361)/(100000000000000000000000000000000000) : ℝ) ((-2258964076508654566553338577426361)/(100000000000000000000000000000000000) : ℝ) := by
  have hchain := cum1304
  have hint1 : MeasureTheory.IntegrableOn (fun x => weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) (Set.Ioc 0 60) := by
    rw [← intervalIntegrable_iff_integrableOn_Ioc_of_le (by norm_num : (0:ℝ) ≤ 60)]
    exact hcont_w.intervalIntegrable 0 60
  have hint2 : MeasureTheory.IntegrableOn (fun x => weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) (Set.Ioi 60) := by
    have hgm := integrableOn_gaussian_moment (T := 60)
    refine MeasureTheory.Integrable.mono' hgm hcont_w.aestronglyMeasurable ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioi] with x hx
    rw [Real.norm_eq_abs, weight_eq_densityWeight]
    exact abs_densityWeight_mul_Omega_le (le_of_lt (Set.mem_Ioi.mp hx))
  have htail : |∫ x in Set.Ioi (60:ℝ), weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x| ≤ 1/10000 := by
    have h := density_tail_le (c := ((1)/(5) : ℝ))
    convert h using 1
    · simp only [weight_eq_densityWeight]
  have hdens : IntersectionForm.density (1/20) ((1)/(5) : ℝ) = (∫ x in (0:ℝ)..60, weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) + ∫ x in Set.Ioi (60:ℝ), weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x := by
    unfold IntersectionForm.density
    have hfun : (fun t => IntersectionForm.densityWeight (1/20) ((1)/(5) : ℝ) t * IntersectionForm.Omega t) = (fun t => weight ((1)/(5) : ℝ) t * IntersectionForm.Omega t) := by
      funext t
      rw [weight_eq_densityWeight]
    rw [hfun]
    exact integral_Ioi_split _ (by norm_num) hint1 hint2
  have hmain : |IntersectionForm.density (1/20) ((1)/(5) : ℝ) - ((-2404259287661354566553338577426361)/(100000000000000000000000000000000000) : ℝ)| ≤ ((1352952111527)/(1000000000000000) : ℝ) + 1/10000 := by
    rw [hdens]
    calc |((∫ x in (0:ℝ)..60, weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) + ∫ x in Set.Ioi (60:ℝ), weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) - ((-2404259287661354566553338577426361)/(100000000000000000000000000000000000) : ℝ)|
        = |((∫ x in (0:ℝ)..60, weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) - ((-2404259287661354566553338577426361)/(100000000000000000000000000000000000) : ℝ)) + ∫ x in Set.Ioi (60:ℝ), weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x| := by ring_nf
      _ ≤ |(∫ x in (0:ℝ)..60, weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x) - ((-2404259287661354566553338577426361)/(100000000000000000000000000000000000) : ℝ)| + |∫ x in Set.Ioi (60:ℝ), weight ((1)/(5) : ℝ) x * IntersectionForm.Omega x| := abs_add_le _ _
      _ ≤ ((1352952111527)/(1000000000000000) : ℝ) + 1/10000 := by linarith [hchain, htail]
  rw [abs_le] at hmain
  constructor <;> linarith [hmain.1, hmain.2]

