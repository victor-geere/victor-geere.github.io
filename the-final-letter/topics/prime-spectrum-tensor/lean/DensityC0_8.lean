    rw [hfun]
    exact integral_Ioi_split _ (by norm_num) hint1 hint2
  have hmain : |IntersectionForm.density (1/20) 0 - ((46786654695590369381669933)/(8000000000000000000000000000) : ℝ)| ≤ ((1352950480143)/(1000000000000000) : ℝ) + 1/10000 := by
    rw [hdens]
    calc |((∫ x in (0:ℝ)..60, weight 0 x * IntersectionForm.Omega x) + ∫ x in Set.Ioi (60:ℝ), weight 0 x * IntersectionForm.Omega x) - ((46786654695590369381669933)/(8000000000000000000000000000) : ℝ)|
        = |((∫ x in (0:ℝ)..60, weight 0 x * IntersectionForm.Omega x) - ((46786654695590369381669933)/(8000000000000000000000000000) : ℝ)) + ∫ x in Set.Ioi (60:ℝ), weight 0 x * IntersectionForm.Omega x| := by ring_nf
      _ ≤ |(∫ x in (0:ℝ)..60, weight 0 x * IntersectionForm.Omega x) - ((46786654695590369381669933)/(8000000000000000000000000000) : ℝ)| + |∫ x in Set.Ioi (60:ℝ), weight 0 x * IntersectionForm.Omega x| := abs_add_le _ _
