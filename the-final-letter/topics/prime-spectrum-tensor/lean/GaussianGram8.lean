import Mathlib
import GaussianGram7

/-!
# The `8 × 8` Gaussian Weil Gram matrix

The `n = 8` rung: eight centres `0, 1/5, …, 7/5`.  Only the `c = 7/5`
separation is new.  The rational matrix `gramCentre8` rounds the exact entries
to eight decimals and the margin is `1/110`, below `λ_min(gramCentre8) ≈
0.009743` and above the entry budget `8·ε = 8·11/10000 = 0.0088`.
-/

set_option maxHeartbeats 4000000

noncomputable section

namespace PrimeSpectrumTensor

open Matrix

/-- The eight centres `0, 1/5, …, 7/5`. -/
def centre8 : Fin 8 → ℝ :=
  ![(0/5 : ℝ), (1/5 : ℝ), (2/5 : ℝ), (3/5 : ℝ), (4/5 : ℝ), (5/5 : ℝ), (6/5 : ℝ), (7/5 : ℝ)]

/-- The exact `8 × 8` Gaussian Weil Gram matrix at width `σ`. -/
def gaussianGram8 (σ : ℝ) : Matrix (Fin 8) (Fin 8) ℝ :=
  Matrix.of fun i j => gaussianGramEntry (centre8 i) (centre8 j) σ

theorem gaussianGram8_symm (σ : ℝ) (i j : Fin 8) :
    gaussianGram8 σ i j = gaussianGram8 σ j i :=
  gaussianGramEntry_symm _ _ _

/-- The finite margin `t = 1/110`. -/
def gramMargin8 : ℝ := 1 / 110

