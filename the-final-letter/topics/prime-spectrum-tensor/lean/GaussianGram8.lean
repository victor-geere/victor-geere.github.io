theorem D8_eq_diagonal :
    D8 = Matrix.diagonal ![(9362389/275000000 : ℝ), (53673772661327/2059725580000000 : ℝ), (1098951855072485299767/42172249948185500000000 : ℝ), (125477939821141231451545549007/4835388162318935318974800000000 : ℝ), (2346611882192366582168833698592337677/96618013662278748217690072735390000000 : ℝ), (21418539641739884753391439527488841318613923/1032509228164641296154286827380628577880000000 : ℝ), (25368839918990905459203455541292692241560356307079/1840655750462021345994576834393572300818384007812500 : ℝ), (725584337308106229529783733422800415813960118548943808101/139528619554449980025619005477109807328581959688934500000000 : ℝ)] := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [D8]

theorem D8_posDef : D8.PosDef := by
  rw [D8_eq_diagonal]
  exact Matrix.PosDef.diagonal fun i => by fin_cases i <;> norm_num

theorem gramCentre8_factor :
    gramCentre8 - gramMargin8 • (1 : Matrix (Fin 8) (Fin 8) ℝ) = L8 * D8 * L8ᵀ := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [gramCentre8, gramMargin8, L8, D8, Matrix.mul_apply, Fin.sum_univ_succ] <;>
    norm_num

theorem L8_transpose_det : (L8ᵀ).det = 1 := by
  rw [Matrix.det_of_isUpperTriangular]
  · apply Finset.prod_eq_one
    intro i _
    fin_cases i <;> simp [L8]
  · intro i j hij
    simp only [Matrix.transpose_apply, L8]
    fin_cases i <;> fin_cases j <;> simp_all

theorem gramCentre8_sub_posDef :
    (gramCentre8 - gramMargin8 • (1 : Matrix (Fin 8) (Fin 8) ℝ)).PosDef := by
  rw [gramCentre8_factor]
  have hD : D8.PosDef := D8_posDef
  have hinj : Function.Injective (L8ᵀ).mulVec := by
    refine Matrix.mulVec_injective_iff_isUnit.mpr ?_
    rw [Matrix.isUnit_iff_isUnit_det, L8_transpose_det]
    exact isUnit_one
  have h := hD.conjTranspose_mul_mul_same (B := L8ᵀ) hinj
  rw [Matrix.conjTranspose_eq_transpose_of_trivial] at h
  simpa only [Matrix.transpose_transpose] using h

theorem gaussianGram8_posDef_of_entry_bound {G : Matrix (Fin 8) (Fin 8) ℝ} {ε : ℝ}
    (hGsym : ∀ i j, G i j = G j i)
    (hε : ∀ i j, |G i j - gramCentre8 i j| ≤ ε)
    (hε0 : 0 ≤ ε)
    (hdim : ε * 8 < gramMargin8) :
    G.PosDef := by
  refine posDef_of_entry_bound hGsym gramCentre8_sub_posDef hε0 hε ?_
  simpa using hdim

/-- The certified 7×7 matrix is a principal submatrix of the 8×8 matrix. -/
theorem gaussianGram7_submatrix_gaussianGram8 :
    (gaussianGram8 (1 / 20)).submatrix (fun i : Fin 7 => Fin.castSucc i)
        (fun i : Fin 7 => Fin.castSucc i) = gaussianGram7 (1 / 20) := by
  ext i j
  simp only [Matrix.submatrix_apply, gaussianGram8, gaussianGram7, Matrix.of_apply]
  have hi : centre8 (Fin.castSucc i) = centre7 i := by
    fin_cases i <;> norm_num [centre8, centre7]
  have hj : centre8 (Fin.castSucc j) = centre7 j := by
    fin_cases j <;> norm_num [centre8, centre7]
  rw [hi, hj]

end PrimeSpectrumTensor
