import Mathlib
import QuadraticInt.LocalTwo

/-!
# Multiplicativity of the ideal count in `ℤ[√−2]`

The coprime-decomposition block (T179–T194 of `Topic.lean`), transported from
`GaussianInt/IdealCount.lean`.  Nothing here depends on `w`; the only
`ℤ[√−2]`-specific input is `absNorm_span_natCast_two`, i.e. `(n)` has norm `n²`.

No `sorry`, `axiom` or `admit`.
-/

noncomputable section

open scoped BigOperators

namespace ZsqrtdTwo

/-- Every ideal divides the principal ideal generated by its norm. -/
lemma ideal_dvd_span_absNorm_two (I : Ideal R2) :
    I ∣ Ideal.span ({((Ideal.absNorm I : ℕ) : R2)} : Set R2) := by
  rw [Ideal.dvd_iff_le]
  exact Ideal.span_le.mpr (by simpa using Ideal.absNorm_mem I)


/-- **T179:** the principal ideals `(m)` and `(n)` are coprime for coprime `m, n`. -/
lemma isCoprime_span_nat_two {m n : ℕ} (h : Nat.Coprime m n) :
    IsCoprime (Ideal.span ({(m : R2)} : Set R2))
      (Ideal.span ({(n : R2)} : Set R2)) := by
  rw [Ideal.isCoprime_span_singleton_iff]
  exact (Nat.Coprime.isCoprime h).map (Int.castRingHom R2)


/-- **T180:** a divisor of `(a)(b)` decomposes as `(K⊔(a))(K⊔(b))` when `a, b` are coprime. -/
lemma coprime_dvd_decompose_two {a b : R2} (hab : IsCoprime a b)
    {K : Ideal R2}
    (hK : K ∣ Ideal.span ({a} : Set R2) * Ideal.span ({b} : Set R2)) :
    K = (K ⊔ Ideal.span ({a} : Set R2)) *
      (K ⊔ Ideal.span ({b} : Set R2)) := by
  let I := Ideal.span ({a} : Set R2)
  let J := Ideal.span ({b} : Set R2)
  have hIJle : I * J ≤ K := Ideal.le_of_dvd hK
  have habK : a * b ∈ K := by
    apply hIJle
    rw [Ideal.span_singleton_mul_span_singleton]
    exact Ideal.subset_span (by simp)
  have hcop : IsCoprime I J := (Ideal.isCoprime_span_singleton_iff a b).mpr hab
  have hsup : (K ⊔ I) ⊔ (K ⊔ J) = ⊤ := by
    have h : (K ⊔ I) ⊔ (K ⊔ J) = (I ⊔ J) ⊔ K := by ac_rfl
    rw [h, Ideal.isCoprime_iff_sup_eq.mp hcop]
    simp
  have hinf : (K ⊔ I) ⊓ (K ⊔ J) = K := by
    apply le_antisymm ?_ (le_inf le_sup_left le_sup_left)
    intro z hz
    rw [Ideal.mem_inf] at hz
    obtain ⟨hzI, hzJ⟩ := hz
    rw [Submodule.mem_sup] at hzI hzJ
    obtain ⟨k1, hk1, i, hi, hik⟩ := hzI
    obtain ⟨k2, hk2, j, hj, hjk⟩ := hzJ
    obtain ⟨x, rfl⟩ := Ideal.mem_span_singleton.mp hi
    obtain ⟨y, rfl⟩ := Ideal.mem_span_singleton.mp hj
    obtain ⟨u, v, huv⟩ := hab
    have hz1 : z = k1 + a * x := hik.symm
    have hz2 : z = k2 + b * y := hjk.symm
    have hza : z * a ∈ K := by
      rw [hz2]
      have heq : (k2 + b * y) * a = k2 * a + (a * b) * y := by ring
      rw [heq]
      exact K.add_mem (K.mul_mem_right a hk2) (K.mul_mem_right y habK)
    have hzb : z * b ∈ K := by
      rw [hz1]
      have heq : (k1 + a * x) * b = k1 * b + (a * b) * x := by ring
      rw [heq]
      exact K.add_mem (K.mul_mem_right b hk1) (K.mul_mem_right x habK)
    have hz : z = u * (z * a) + v * (z * b) := by
      calc z = z * 1 := by ring
        _ = z * (u * a + v * b) := by rw [huv]
        _ = u * (z * a) + v * (z * b) := by ring
    rw [hz]
    exact K.add_mem (K.mul_mem_left u hza) (K.mul_mem_left v hzb)
  have hprod : (K ⊔ I) * (K ⊔ J) = (K ⊔ I) ⊓ (K ⊔ J) := by
    have := Ideal.sup_mul_inf (K ⊔ I) (K ⊔ J)
    rw [hsup, Ideal.top_mul] at this
    exact this.symm
  conv_lhs => rw [← hinf]
  rw [hprod]



/-- **T182:** a divisor of a product of coprime ideals splits as `(K⊔I)(K⊔J)`. -/
lemma ideal_coprime_dvd_decompose {I J K : Ideal R2} (hIJ : IsCoprime I J)
    (hK : K ∣ I * J) : K = (K ⊔ I) * (K ⊔ J) := by
  have hIJle : I * J ≤ K := Ideal.le_of_dvd hK
  obtain ⟨i, hi, j, hj, hij⟩ := hIJ.exists
  have hsup : (K ⊔ I) ⊔ (K ⊔ J) = ⊤ := by
    have h : (K ⊔ I) ⊔ (K ⊔ J) = (I ⊔ J) ⊔ K := by ac_rfl
    rw [h, Ideal.isCoprime_iff_sup_eq.mp hIJ]
    simp
  have hinf : (K ⊔ I) ⊓ (K ⊔ J) = K := by
    apply le_antisymm ?_ (le_inf le_sup_left le_sup_left)
    intro z hz
    rw [Ideal.mem_inf] at hz
    obtain ⟨hzI, hzJ⟩ := hz
    rw [Submodule.mem_sup] at hzI hzJ
    obtain ⟨k1, hk1, i1, hi1, hik⟩ := hzI
    obtain ⟨k2, hk2, j2, hj2, hjk⟩ := hzJ
    have hz1 : z = k1 + i1 := hik.symm
    have hz2 : z = k2 + j2 := hjk.symm
    have hzi : z * i ∈ K := by
      rw [hz2, add_mul]
      have hmul : j2 * i ∈ I * J := by
        rw [mul_comm j2 i]
        exact Ideal.mul_mem_mul hi hj2
      exact K.add_mem (K.mul_mem_right i hk2) (hIJle hmul)
    have hzj : z * j ∈ K := by
      rw [hz1, add_mul]
      exact K.add_mem (K.mul_mem_right j hk1) (hIJle (Ideal.mul_mem_mul hi1 hj))
    have hz : z = z * i + z * j := by
      rw [← mul_add, hij, mul_one]
    rw [hz]
    exact K.add_mem hzi hzj
  have hprod : (K ⊔ I) * (K ⊔ J) = (K ⊔ I) ⊓ (K ⊔ J) := by
    have := Ideal.sup_mul_inf (K ⊔ I) (K ⊔ J)
    rw [hsup, Ideal.top_mul] at this
    exact this.symm
  conv_lhs => rw [← hinf]
  rw [hprod]



/-- **T189:** if `a ∣ m²`, `b ∣ n²`, `ab = mn` and `m, n` are coprime, then `a = m`, `b = n`. -/
lemma nat_eq_of_dvd_sq_mul {a b m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (hcop : Nat.Coprime m n) (ha : a ∣ m ^ 2) (hb : b ∣ n ^ 2)
    (hab : a * b = m * n) : a = m ∧ b = n := by
  have hmb : Nat.Coprime m b := (hcop.pow_right 2).of_dvd_right hb
  have hma : m ∣ a := by
    have : m ∣ a * b := by rw [hab]; exact dvd_mul_right m n
    exact hmb.dvd_of_dvd_mul_right this
  have hna : Nat.Coprime n a := by
    have hnm : Nat.Coprime n (m ^ 2) := hcop.symm.pow_right 2
    exact hnm.of_dvd_right ha
  have hnb : n ∣ b := by
    have : n ∣ a * b := by rw [hab]; exact dvd_mul_left n m
    exact hna.dvd_of_dvd_mul_left this
  obtain ⟨c, rfl⟩ := hma
  obtain ⟨d, rfl⟩ := hnb
  have hmul : m * n * (c * d) = m * n * 1 := by
    calc m * n * (c * d) = m * c * (n * d) := by ring
      _ = m * n := hab
      _ = m * n * 1 := by ring
  have hmn : 0 < m * n := Nat.mul_pos (Nat.pos_of_ne_zero hm) (Nat.pos_of_ne_zero hn)
  have hcd : c * d = 1 := Nat.mul_left_cancel hmn hmul
  have hc : c = 1 := Nat.eq_one_of_mul_eq_one_right hcd
  have hd : d = 1 := Nat.eq_one_of_mul_eq_one_left hcd
  constructor <;> simp [hc, hd]

/-- **T190:** for ideals of coprime norms `m, n`, `(K1 K2) ⊔ (m) = K1`. -/
lemma sup_mul_span_eq_two {K1 K2 : Ideal R2} {m n : ℕ}
    (hK1 : Ideal.absNorm K1 = m) (hK2 : Ideal.absNorm K2 = n)
    (hcop : Nat.Coprime m n) :
    (K1 * K2) ⊔ Ideal.span ({(m : R2)} : Set R2) = K1 := by
  have hspan_m : K1 ∣ Ideal.span ({(m : R2)} : Set R2) := by
    rw [← hK1]
    exact ideal_dvd_span_absNorm_two K1
  have hspan_n : K2 ∣ Ideal.span ({(n : R2)} : Set R2) := by
    rw [← hK2]
    exact ideal_dvd_span_absNorm_two K2
  have hcop_span : IsCoprime (Ideal.span ({(m : R2)} : Set R2))
      (Ideal.span ({(n : R2)} : Set R2)) :=
    isCoprime_span_nat_two hcop
  have hcop_K1K2 : IsCoprime K1 K2 :=
    (hcop_span.of_isCoprime_of_dvd_left hspan_m).of_isCoprime_of_dvd_right hspan_n
  rw [dvd_iff_exists_eq_mul_left] at hspan_m
  obtain ⟨J, hJ⟩ := hspan_m
  have hJ' : Ideal.span ({(m : R2)} : Set R2) = K1 * J := by
    rw [hJ, mul_comm]
  have hJdvd : J ∣ Ideal.span ({(m : R2)} : Set R2) :=
    ⟨K1, by rw [hJ', mul_comm]⟩
  have hcop_K2_m : IsCoprime K2 (Ideal.span ({(m : R2)} : Set R2)) :=
    (hcop_span.of_isCoprime_of_dvd_right hspan_n).symm
  have hcop_K2_J : IsCoprime K2 J := hcop_K2_m.of_isCoprime_of_dvd_right hJdvd
  have hsup : K2 ⊔ J = ⊤ := Ideal.isCoprime_iff_sup_eq.mp hcop_K2_J
  calc (K1 * K2) ⊔ Ideal.span ({(m : R2)} : Set R2)
      = (K1 * K2) ⊔ (K1 * J) := by rw [hJ']
    _ = K1 * (K2 ⊔ J) := by rw [Ideal.mul_sup]
    _ = K1 * ⊤ := by rw [hsup]
    _ = K1 := by rw [Ideal.mul_top]


/-- **T191:** the left component of an ideal of norm `mn` has norm `m`. -/
lemma sup_span_absNorm_left_two {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (hcop : Nat.Coprime m n) (K : Ideal R2)
    (hK : Ideal.absNorm K = m * n) :
    Ideal.absNorm (K ⊔ Ideal.span ({(m : R2)} : Set R2)) = m := by
  have hKdvd : K ∣ Ideal.span ({((m * n : ℕ) : R2)} : Set R2) := by
    rw [← hK]
    exact ideal_dvd_span_absNorm_two K
  have hspan : Ideal.span ({((m * n : ℕ) : R2)} : Set R2) =
      Ideal.span ({(m : R2)} : Set R2) *
        Ideal.span ({(n : R2)} : Set R2) := by
    rw [Ideal.span_singleton_mul_span_singleton, Nat.cast_mul]
  have hKdvd' : K ∣ Ideal.span ({(m : R2)} : Set R2) *
      Ideal.span ({(n : R2)} : Set R2) := by
    rwa [← hspan]
  have hcop_span : IsCoprime (Ideal.span ({(m : R2)} : Set R2))
      (Ideal.span ({(n : R2)} : Set R2)) :=
    isCoprime_span_nat_two hcop
  have hdecomp := ideal_coprime_dvd_decompose hcop_span hKdvd'
  have h1dvd : (K ⊔ Ideal.span ({(m : R2)} : Set R2)) ∣
      Ideal.span ({(m : R2)} : Set R2) :=
    Ideal.dvd_iff_le.mpr le_sup_right
  have h2dvd : (K ⊔ Ideal.span ({(n : R2)} : Set R2)) ∣
      Ideal.span ({(n : R2)} : Set R2) :=
    Ideal.dvd_iff_le.mpr le_sup_right
  have h1 : Ideal.absNorm (K ⊔ Ideal.span ({(m : R2)} : Set R2)) ∣ m ^ 2 := by
    have := Ideal.absNorm_dvd_absNorm_of_le (I := K ⊔ Ideal.span ({(m : R2)} : Set R2))
      (J := Ideal.span ({(m : R2)} : Set R2)) le_sup_right
    rwa [absNorm_span_natCast_two] at this
  have h2 : Ideal.absNorm (K ⊔ Ideal.span ({(n : R2)} : Set R2)) ∣ n ^ 2 := by
    have := Ideal.absNorm_dvd_absNorm_of_le (I := K ⊔ Ideal.span ({(n : R2)} : Set R2))
      (J := Ideal.span ({(n : R2)} : Set R2)) le_sup_right
    rwa [absNorm_span_natCast_two] at this
  have hprod : Ideal.absNorm (K ⊔ Ideal.span ({(m : R2)} : Set R2)) *
      Ideal.absNorm (K ⊔ Ideal.span ({(n : R2)} : Set R2)) = m * n := by
    have hK' : Ideal.absNorm ((K ⊔ Ideal.span ({(m : R2)} : Set R2)) *
        (K ⊔ Ideal.span ({(n : R2)} : Set R2))) = m * n := by
      conv_lhs => rw [← hdecomp]
      rw [hK]
    rwa [map_mul] at hK'
  exact (nat_eq_of_dvd_sq_mul hm hn hcop h1 h2 hprod).1

/-- **T192:** the right component of an ideal of norm `mn` has norm `n`. -/
lemma sup_span_absNorm_right_two {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (hcop : Nat.Coprime m n) (K : Ideal R2)
    (hK : Ideal.absNorm K = m * n) :
    Ideal.absNorm (K ⊔ Ideal.span ({(n : R2)} : Set R2)) = n := by
  have h := sup_span_absNorm_left_two hn hm hcop.symm K (by rwa [mul_comm] at hK)
  simpa [mul_comm] using h

/-- **T193:** the ideal-count product equivalence. -/
noncomputable def idealCountEquivTwo (m n : ℕ) (hm : m ≠ 0) (hn : n ≠ 0)
    (hcop : Nat.Coprime m n) :
    {I : Ideal R2 // Ideal.absNorm I = m * n} ≃
      {I : Ideal R2 // Ideal.absNorm I = m} ×
        {I : Ideal R2 // Ideal.absNorm I = n} where
  toFun I :=
    (⟨I.1 ⊔ Ideal.span ({(m : R2)} : Set R2),
        sup_span_absNorm_left_two hm hn hcop I.1 I.2⟩,
      ⟨I.1 ⊔ Ideal.span ({(n : R2)} : Set R2),
        sup_span_absNorm_right_two hm hn hcop I.1 I.2⟩)
  invFun p :=
    ⟨p.1.1 * p.2.1, by rw [map_mul, p.1.2, p.2.2]⟩
  left_inv I := by
    apply Subtype.ext
    have hKdvd : I.1 ∣ Ideal.span ({((Ideal.absNorm I.1 : ℕ) : R2)} : Set R2) :=
      ideal_dvd_span_absNorm_two I.1
    rw [I.2] at hKdvd
    have hspan : Ideal.span ({((m * n : ℕ) : R2)} : Set R2) =
        Ideal.span ({(m : R2)} : Set R2) *
          Ideal.span ({(n : R2)} : Set R2) := by
      rw [Ideal.span_singleton_mul_span_singleton, Nat.cast_mul]
    have hKdvd' : I.1 ∣ Ideal.span ({(m : R2)} : Set R2) *
        Ideal.span ({(n : R2)} : Set R2) := by
      rwa [← hspan]
    exact (ideal_coprime_dvd_decompose (isCoprime_span_nat_two hcop) hKdvd').symm
  right_inv p := by
    apply Prod.ext
    · apply Subtype.ext
      exact sup_mul_span_eq_two p.1.2 p.2.2 hcop
    · apply Subtype.ext
      have h := sup_mul_span_eq_two (m := n) (n := m) p.2.2 p.1.2 hcop.symm
      simpa [mul_comm] using h

/-- **T194:** the ideal count is multiplicative over coprime `m, n`. -/
theorem idealCountTwo_mul {m n : ℕ} (hm : m ≠ 0) (hn : n ≠ 0)
    (hcop : Nat.Coprime m n) :
    Nat.card {I : Ideal R2 // Ideal.absNorm I = m * n} =
      Nat.card {I : Ideal R2 // Ideal.absNorm I = m} *
        Nat.card {I : Ideal R2 // Ideal.absNorm I = n} := by
  rw [Nat.card_congr (idealCountEquivTwo m n hm hn hcop), Nat.card_prod]


end ZsqrtdTwo
