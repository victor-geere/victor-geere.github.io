/-
  Rh47/Parity.lean — O12: sign-blindness / the parity principle, formalised.

  ## The restricted setting

  A *sign-blind weight family generated by small-prime residue conditions* is a
  finite integer combination of divisibility indicators

      w(n) = ∑_{d ∈ D} c_d · 1_{d ∣ n},

  `D` a finite set of moduli and `c : ℕ → ℝ`.  This is exactly the class of
  *linear-sieve* weights: the weight is fixed by finitely many congruence
  conditions `n ≡ 0 (mod d)` and never mentions `λ`, `Ω` or any arithmetic datum
  beyond divisibility.  It is the family in which Selberg's parity obstruction is
  usually stated.

  ## The theorem (the parity principle, algebraic form)

  The whole content of sign-blindness for this family is the exact collapse

      ∑_{n ≤ N} w(n) λ(n) = ∑_{d ∈ D} c_d λ(d) · (∑_{m ≤ N/d} λ(m)),

  i.e. **every sign-blind sieve weight sees `λ` only through the one-point sums
  `∑_{m ≤ M} λ(m)`** — the weight itself contributes nothing but the multipliers
  `λ(d)` and the level ratios `N/d`.  Consequently

  * (`sieveLam_abs_le`) if the one-point sums are uniformly `≤ ε·M` up to `N`,
    then `|∑_{n ≤ N} w(n) λ(n)| ≤ (∑_d |c_d|) · ε · N`: a sign-blind weight can
    only reproduce the decay that is already in the one-point sums, never
    manufacture a positive-density correlation;
  * (`sieveLam_vanishes`) if the one-point sums vanish, `∑_{m ≤ M} λ(m) = o(M)`
    — which is PNT, the `k = 1` case of Chowla, register item OP-2 — then *every*
    sign-blind weight has `∑_{n ≤ N} w(n) λ(n) = o(N)`.

  This is precisely the "known sub-case" recorded in `research/TODO.md` §A.1 and
  the reason the parity barrier is *structural* rather than a gap in technique:
  the family cannot reach the un-averaged two-point correlation, because all of
  its correlations are one-point sums in disguise.  Selberg's full parity
  principle (that a sieve of level `D < x^{1/2}` cannot separate `Ω`-even from
  `Ω`-odd) is the same statement, made quantitative in the sieve level; the
  formalised part below is its exact algebraic skeleton, with the `k = 1`
  Chowla/PNT input carried as the explicit hypothesis `LiouvilleVanishes`.

  There is no `sorry`, no `axiom` and no `native_decide`.
-/
import Rh46.Chowla

namespace Rh47

open scoped BigOperators
open Filter

noncomputable section

/-! ## The weight family and the alternating sums -/

/-- A **sign-blind linear-sieve weight**: the finite integer combination
`n ↦ ∑_{d ∈ D} c d · 1_{d ∣ n}` of divisibility indicators.  Determined by the
moduli `D` and the coefficients `c`, with no reference to `λ` or `Ω`. -/
def sieveWeight (D : Finset ℕ) (c : ℕ → ℝ) (n : ℕ) : ℝ :=
  ∑ d ∈ D, c d * (if d ∣ n then (1 : ℝ) else 0)

/-- The one-point Liouville sum `∑_{m ≤ N} λ(m)`, in `ℝ`. -/
def lamSum (N : ℕ) : ℝ := ∑ m ∈ Finset.Icc 1 N, (Rh46.liouville m : ℝ)

/-- The `λ`-correlation of a sign-blind sieve weight over `[1, N]`. -/
def sieveLam (D : Finset ℕ) (c : ℕ → ℝ) (N : ℕ) : ℝ :=
  ∑ n ∈ Finset.Icc 1 N, sieveWeight D c n * (Rh46.liouville n : ℝ)

/-! ## The collapse identity -/

/-- Summing `λ` over the multiples of `d` in `[1, N]` is `λ(d)` times the
one-point sum at level `N / d` (complete multiplicativity of `λ`). -/
lemma sum_liouville_multiples {d N : ℕ} (hd : 1 ≤ d) :
    ∑ n ∈ (Finset.Icc 1 N).filter (fun n => d ∣ n), (Rh46.liouville n : ℝ)
      = (Rh46.liouville d : ℝ) * lamSum (N / d) := by
  have hd0 : d ≠ 0 := by omega
  have hdpos : 0 < d := by omega
  have himg : (Finset.Icc 1 N).filter (fun n => d ∣ n)
      = (Finset.Icc 1 (N / d)).image (fun m => d * m) := by
    ext n
    simp only [Finset.mem_filter, Finset.mem_Icc, Finset.mem_image]
    constructor
    · rintro ⟨⟨hn1, hnN⟩, hdn⟩
      have hdn_pos : 0 < n := by omega
      refine ⟨n / d, ⟨?_, ?_⟩, Nat.mul_div_cancel' hdn⟩
      · rw [Nat.le_div_iff_mul_le hdpos]
        simpa using Nat.le_of_dvd hdn_pos hdn
      · exact Nat.div_le_div_right hnN
    · rintro ⟨m, ⟨hm1, hmN⟩, rfl⟩
      refine ⟨⟨?_, ?_⟩, dvd_mul_right d m⟩
      · calc (1 : ℕ) = 1 * 1 := by ring
          _ ≤ d * m := Nat.mul_le_mul hd hm1
      · exact le_trans (Nat.mul_le_mul_left d hmN) (Nat.mul_div_le N d)
  have hinj : ∀ x ∈ Finset.Icc 1 (N / d), ∀ y ∈ Finset.Icc 1 (N / d),
      d * x = d * y → x = y := by
    intro x _ y _ hxy
    exact Nat.mul_left_cancel hdpos hxy
  rw [himg, Finset.sum_image hinj]
  rw [lamSum, Finset.mul_sum]
  refine Finset.sum_congr rfl (fun m hm => ?_)
  rw [Finset.mem_Icc] at hm
  have hm0 : m ≠ 0 := by omega
  rw [Rh46.liouville_mul hd0 hm0]
  push_cast
  ring

/-- **The parity collapse.**  Every sign-blind linear-sieve weight correlates
with `λ` only through the one-point sums: -/
theorem sieveLam_collapse (D : Finset ℕ) (c : ℕ → ℝ) (N : ℕ)
    (hD : ∀ d ∈ D, 1 ≤ d) :
    sieveLam D c N
      = ∑ d ∈ D, c d * (Rh46.liouville d : ℝ) * lamSum (N / d) := by
  unfold sieveLam sieveWeight
  simp only [Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl (fun d hd => ?_)
  have hterm : (∑ x ∈ Finset.Icc 1 N,
        (c d * (if d ∣ x then (1 : ℝ) else 0)) * (Rh46.liouville x : ℝ))
      = c d * ∑ x ∈ (Finset.Icc 1 N).filter (fun x => d ∣ x), (Rh46.liouville x : ℝ) := by
    rw [Finset.mul_sum, Finset.sum_filter]
    refine Finset.sum_congr rfl (fun x _ => ?_)
    by_cases h : d ∣ x <;> simp [h]
  rw [hterm, sum_liouville_multiples (hD d hd)]
  ring

/-! ## The quantitative parity bound -/

/-- **A sign-blind weight cannot beat the one-point sums.**  If the one-point
Liouville sums are uniformly `≤ ε·M` for `M ≤ N`, then the `λ`-correlation of
*every* sign-blind linear-sieve weight is `≤ (∑_d |c_d|)·ε·N`.  The sieve
multiplies the available decay; it cannot create its own. -/
theorem sieveLam_abs_le (D : Finset ℕ) (c : ℕ → ℝ) (N : ℕ)
    (hD : ∀ d ∈ D, 1 ≤ d) {ε : ℝ} (hε0 : 0 ≤ ε)
    (hε : ∀ M : ℕ, M ≤ N → |lamSum M| ≤ ε * M) :
    |sieveLam D c N| ≤ (∑ d ∈ D, |c d|) * ε * N := by
  rw [sieveLam_collapse D c N hD]
  have hkey : ∀ d ∈ D,
      |c d * (Rh46.liouville d : ℝ) * lamSum (N / d)| ≤ |c d| * (ε * N) := by
    intro d hd
    have hNdiv : N / d ≤ N := Nat.div_le_self N d
    have h1 : |lamSum (N / d)| ≤ ε * N := by
      have hεd := hε (N / d) hNdiv
      have hcast : ((N / d : ℕ) : ℝ) ≤ (N : ℝ) := by exact_mod_cast hNdiv
      exact le_trans hεd (mul_le_mul_of_nonneg_left hcast hε0)
    have h2 : |(Rh46.liouville d : ℝ)| ≤ 1 := by
      have := Rh46.liouville_abs_le_one d
      rw [← Int.cast_abs]
      exact_mod_cast this
    rw [abs_mul, abs_mul]
    have h3 : |c d| * |(Rh46.liouville d : ℝ)| ≤ |c d| := by
      calc |c d| * |(Rh46.liouville d : ℝ)| ≤ |c d| * 1 :=
            mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
        _ = |c d| := by ring
    have h4 : |c d| * |(Rh46.liouville d : ℝ)| * |lamSum (N / d)| ≤ |c d| * (ε * N) := by
      calc |c d| * |(Rh46.liouville d : ℝ)| * |lamSum (N / d)|
          ≤ |c d| * |lamSum (N / d)| := by
            exact mul_le_mul_of_nonneg_right h3 (abs_nonneg _)
        _ ≤ |c d| * (ε * N) := mul_le_mul_of_nonneg_left h1 (abs_nonneg _)
    exact h4
  calc |∑ d ∈ D, c d * (Rh46.liouville d : ℝ) * lamSum (N / d)|
      ≤ ∑ d ∈ D, |c d * (Rh46.liouville d : ℝ) * lamSum (N / d)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ d ∈ D, |c d| * (ε * N) := Finset.sum_le_sum hkey
    _ = (∑ d ∈ D, |c d|) * (ε * N) := by rw [Finset.sum_mul]
    _ = (∑ d ∈ D, |c d|) * ε * N := by ring

/-! ## The parity principle (asymptotic form) -/

/-- The `k = 1` Chowla / PNT input: `∑_{m ≤ M} λ(m) = o(M)`
(register item OP-2; proved, but not available in Mathlib's form here). -/
def LiouvilleVanishes : Prop :=
  ∀ ε : ℝ, 0 < ε → ∀ᶠ M : ℕ in atTop, |lamSum M| ≤ ε * M

/-- Each fixed level `N ↦ N / d` (`d ≥ 1`) tends to infinity. -/
lemma tendsto_div_atTop {d : ℕ} (hd : 1 ≤ d) : Tendsto (fun N : ℕ => N / d) atTop atTop := by
  rw [tendsto_atTop_atTop]
  intro b
  refine ⟨b * d, fun N hN => ?_⟩
  rw [Nat.le_div_iff_mul_le (by omega : 0 < d)]
  exact hN

/-- **The parity principle.**  If one-point Chowla holds (`λ` has mean zero),
then *every* sign-blind weight generated by small-prime residue conditions has
vanishing `λ`-correlation: `∑_{n ≤ N} w(n) λ(n) = o(N)`, uniformly over the whole
family.  The sieve cannot manufacture a correlation the one-point sums do not
already supply. -/
theorem sieveLam_vanishes (hPNT : LiouvilleVanishes) (D : Finset ℕ) (c : ℕ → ℝ)
    (hD : ∀ d ∈ D, 1 ≤ d) :
    ∀ ε : ℝ, 0 < ε → ∀ᶠ N : ℕ in atTop, |sieveLam D c N| ≤ ε * N := by
  intro ε hε
  by_cases hD0 : D = ∅
  · subst hD0
    filter_upwards with N
    rw [sieveLam_collapse ∅ c N (by simp)]
    simp only [Finset.sum_empty, abs_zero]
    positivity
  have hne : D.Nonempty := Finset.nonempty_iff_ne_empty.mpr hD0
  set K : ℝ := ∑ d ∈ D, |c d| with hK
  have hKpos : 0 ≤ K := Finset.sum_nonneg (fun d _ => abs_nonneg _)
  set ε' : ℝ := ε / (K + 1) with hε'
  have hε'pos : 0 < ε' := by
    rw [hε']; positivity
  have hK1 : K * ε' ≤ ε := by
    rw [hε', mul_div_assoc']
    rw [div_le_iff₀ (by positivity : (0:ℝ) < K + 1)]
    nlinarith [hKpos]
  -- eventually, for every `d ∈ D`, `|lamSum (N/d)| ≤ ε'·(N/d)`
  have hev : ∀ᶠ N : ℕ in atTop, ∀ d ∈ D, |lamSum (N / d)| ≤ ε' * (N / d : ℕ) := by
    rw [Finset.eventually_all]
    intro d hd
    exact (tendsto_div_atTop (hD d hd)).eventually (hPNT ε' hε'pos)
  filter_upwards [hev] with N hN
  rw [sieveLam_collapse D c N hD]
  have hbound : ∀ d ∈ D,
      |c d * (Rh46.liouville d : ℝ) * lamSum (N / d)| ≤ |c d| * (ε' * N) := by
    intro d hd
    have h2 : |(Rh46.liouville d : ℝ)| ≤ 1 := by
      have := Rh46.liouville_abs_le_one d
      rw [← Int.cast_abs]
      exact_mod_cast this
    have hNdiv : ((N / d : ℕ) : ℝ) ≤ (N : ℝ) := by
      exact_mod_cast Nat.div_le_self N d
    have hnd : ε' * (N / d : ℕ) ≤ ε' * N :=
      mul_le_mul_of_nonneg_left hNdiv (le_of_lt hε'pos)
    have h1 : |lamSum (N / d)| ≤ ε' * N := le_trans (hN d hd) hnd
    rw [abs_mul, abs_mul]
    calc |c d| * |(Rh46.liouville d : ℝ)| * |lamSum (N / d)|
        ≤ |c d| * |lamSum (N / d)| := by
          refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
          calc |c d| * |(Rh46.liouville d : ℝ)| ≤ |c d| * 1 :=
                mul_le_mul_of_nonneg_left h2 (abs_nonneg _)
            _ = |c d| := by ring
      _ ≤ |c d| * (ε' * N) := mul_le_mul_of_nonneg_left h1 (abs_nonneg _)
  calc |∑ d ∈ D, c d * (Rh46.liouville d : ℝ) * lamSum (N / d)|
      ≤ ∑ d ∈ D, |c d * (Rh46.liouville d : ℝ) * lamSum (N / d)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ d ∈ D, |c d| * (ε' * N) := Finset.sum_le_sum hbound
    _ = K * (ε' * N) := by rw [hK, Finset.sum_mul]
    _ = (K * ε') * N := by ring
    _ ≤ ε * N := mul_le_mul_of_nonneg_right hK1 (Nat.cast_nonneg N)

/-! ## A concrete instance: index parity is invisible to the `h = 2` correlation -/

/-- The twisted two-point correlation `∑_{n ≤ N} (λ(n)(−1)^n)(λ(n+2)(−1)^{n+2})`
equals the untwisted one: the index-parity twist cancels identically.  This is
the exact identity `rh47` measured with `0/10^6` mismatches; here it is proved. -/
theorem corr_twist_two (N : ℕ) :
    ∑ n ∈ Finset.Icc 1 N,
        ((Rh46.liouville n : ℤ) * (-1) ^ n) * ((Rh46.liouville (n + 2) : ℤ) * (-1) ^ (n + 2))
      = Rh46.corr 2 N := by
  unfold Rh46.corr
  refine Finset.sum_congr rfl (fun n _ => ?_)
  have hpar : ((-1 : ℤ) ^ n) * ((-1 : ℤ) ^ (n + 2)) = 1 := by
    rw [← pow_add]
    have : n + (n + 2) = 2 * (n + 1) := by ring
    rw [this, pow_mul]
    norm_num
  calc (Rh46.liouville n * (-1) ^ n) * (Rh46.liouville (n + 2) * (-1) ^ (n + 2))
      = Rh46.liouville n * Rh46.liouville (n + 2) * (((-1 : ℤ) ^ n) * ((-1 : ℤ) ^ (n + 2))) := by
        ring
    _ = Rh46.liouville n * Rh46.liouville (n + 2) := by rw [hpar]; ring

end

end Rh47
